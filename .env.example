# ============================================================
# KRONOS — Configuração da nuvem (Supabase). OPCIONAL.
# Sem estas variáveis, o app roda 100% local (localStorage).
# Com elas, os dados vão para a nuvem e ficam acessíveis de
# qualquer máquina, com login por e-mail/senha (Supabase Auth).
#
# 1. Crie um projeto grátis em https://supabase.com
# 2. Rode o SQL de supabase/schema.sql no SQL Editor
# 3. Copie este arquivo para ".env" e preencha (Project Settings > API)
# ============================================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
